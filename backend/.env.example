# Cổng chạy API
PORT=3001

# MySQL: thay tài khoản, mật khẩu và tên database theo môi trường của bạn.
# Database phải được tạo trước. Mật khẩu không cần URL-encode; đặt trong dấu nháy kép nếu có # hoặc khoảng trắng.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cineflow_user
DB_PASSWORD=change_me
DB_NAME=cineflow

# Secret used to sign API access tokens. Generate at least 32 random bytes per environment.
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_bytes

# Allowed web origins, separated by commas.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Number of trusted reverse proxies; use 1 on Render, 0 locally.
TRUST_PROXY=0

# Optional public CDN/object-storage URL for uploaded posters, videos and subtitles.
# MEDIA_PUBLIC_BASE_URL=https://cdn.example.com/cineflow/

# Only used by npm run admin:create; set temporarily and remove after creating the first admin.
# ADMIN_BOOTSTRAP_EMAIL=admin@example.com
# Replace the example with a private password before running admin:create.
# ADMIN_BOOTSTRAP_PASSWORD=ReplaceThis123!
# ADMIN_BOOTSTRAP_NAME=Cineflow Admin
